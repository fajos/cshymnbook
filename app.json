{
  "expo": {
    "name": "C&S Hymn Book",
    "slug": "cshymnbook",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B1B3D"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fajostech.cshymnbook",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B1B3D",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "package": "com.fajostech.cshymnbook",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "18fcefc1-500c-4346-9799-a7b3162caba7"
      }
    },
    "owner": "cshymnbook"
  }
}
